# PostgreSQL
DB_NAME=madalogistics
DB_USER=madalogistics
DB_PASSWORD=change-me-in-your-local-.env
DB_HOST=db
DB_PORT=5432

# JWT (secret : au moins 32 caractères aléatoires)
JWT_SECRET=generate-a-strong-random-secret-with-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Ports hôtes
FRONTEND_PORT=8080
BACKEND_PORT=8081
POSTGRES_PORT=5432

# Maps (upstream OSM, surchargeable en prod)
MAPS_GEOCODE_URL=https://nominatim.openstreetmap.org
MAPS_ROUTING_URL=https://router.project-osrm.org
MAPS_USER_AGENT=MadaLogistix/1.0 (contact: admin@madalogistix.mg)
